.env
.env.*
!.env.example
.idea
node_modules/
dist/
build/
coverage/
.turbo/
.vite/
*.tsbuildinfo

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

*.log

# mkcert-generated TLS cert pairs — regenerate locally per dev machine
certs/*.pem

# Runtime data — workspaces, workspace meta, publish projects.
# All project state lives here so the project is self-contained.
.data/

# MinIO bind-mount data
infra/minio/data/

# Claude Code local settings and runtime files
.claude/settings.local.json
.claude/*.lock
seed-data/

# Playwright e2e artifacts
test-results/
playwright-report/
playwright/.cache/

# Playwright MCP runtime artifacts (per-session console logs and
# screenshots; regenerated on every browser run).
.playwright-mcp/

# Ad-hoc screenshots dropped at the repo root (drag-and-drop aids,
# bug repros, design references).  Real frontend assets live under
# `apps/web/public/` — those PNGs are not affected.
/*.png
