.DS_Store
.env
.env.*
!.env.example
.idea
node_modules/

# pnpm content store; created by welcome-build container at workspace root
.pnpm-store/
dist/
build/
coverage/
.turbo/
.vite/
*.tsbuildinfo

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

*.log

# mkcert-generated TLS cert pairs — regenerate locally per dev machine
certs/*.pem

# Runtime data — workspaces, workspace meta, publish projects.
# All project state lives here so the project is self-contained.
.data/

# MinIO bind-mount data
infra/minio/data/

# Claude Code local settings and runtime files
.claude/settings.local.json
.claude/*.lock
seed-data/

# Playwright e2e artifacts
test-results/
playwright-report/
playwright/.cache/

# Playwright MCP runtime artifacts (per-session console logs and
# screenshots; regenerated on every browser run).
.playwright-mcp/

# Ad-hoc screenshots dropped at the repo root (drag-and-drop aids,
# bug repros, design references).  Real frontend assets live under
# `apps/web/public/` — those PNGs are not affected.
/*.png

# Replay recordings — kept local-only.  Real fixtures carry the dev
# stack's docker-internal IPs, plan-type metadata, and the URLs of
# our internal Pinterest proxy in pinterest_refs[].max/.normal.  None
# of it is a credential, but ship discipline says don't commit infra
# coordinates if we don't have to.  Operators record locally; CI
# replay tests skip when the fixture is absent.
#
# The ``_dummy`` pair stays in git — it's hand-crafted, contains no
# real-stack data, and keeps the schema validator alive on a fresh
# clone.
tests/fixtures/replay/raw/*.json
tests/fixtures/replay/raw/*.json.gz
tests/fixtures/replay/assets/*
!tests/fixtures/replay/raw/_dummy.json
!tests/fixtures/replay/assets/.gitkeep
